# Port HTTP server Express (default: 3000)
PORT=3000

# Mode runtime aplikasi: "development" (Vite middleware) atau "production" (serve dist/)
NODE_ENV=development

# Opsional: Hanya dipakai jika Frontend (Firebase Hosting Spark) dipisah dari Backend (Render/Koyeb)
# URL backend tanpa slash di akhir, misal: https://massbim-lens-api.onrender.com
# VITE_API_BASE_URL=

# Opsional (Backend): Daftar origin frontend yang diizinkan CORS, dipisah koma
# Contoh: https://massbim-lens.web.app,https://massbim-lens.firebaseapp.com,https://lens.massbim.my.id
# ALLOWED_ORIGINS=

# Opsional (Backend): URL publik frontend untuk tombol "Audit Website Ini (Self-Audit)" saat split-hosting
# PUBLIC_APP_URL=

